# 558NET Customer Management System - Environment Variables
# Copy this file to .env.local and fill in your values

# Google Spreadsheet ID (found in the URL of your Google Sheet)
# Example: https://docs.google.com/spreadsheets/d/YOUR_SHEET_ID/edit
VITE_GOOGLE_SHEET_ID=your_google_sheet_id_here

# Google Apps Script Web App URL
# Get this after deploying your Apps Script as a Web App
VITE_GOOGLE_APPS_SCRIPT_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec
